# Copy this file to .streamlit/secrets.toml for local dev, OR paste the
# contents into the "Secrets" box in the Streamlit Community Cloud app
# settings. NEVER commit the real secrets.toml.

[azure]
# Full Azure Storage connection string from the Azure Portal
# (Storage account -> Security + networking -> Access keys -> Connection string)
connection_string = "DefaultEndpointsProtocol=https;AccountName=YOURACCOUNT;AccountKey=YOURKEY;EndpointSuffix=core.windows.net"

# Blob container that holds the two files
container = "revenue-cycle"

# Blob names (upload replacement files under these exact names when refreshing)
superbill_blob = "SuperBill_latest.xlsx"
tracker_blob   = "SuperBill_tracker_latest.xlsx"

# Optional: set if the data is NOT on the first sheet
# superbill_sheet = "Sheet1"
# tracker_sheet   = "Sheet1"
